# Copy to .env and fill in. The .env file is git-ignored.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=biobot
DB_USER=biobot
DB_PASSWORD=change-me

# Required. Generate with:  openssl rand -base64 32
JWT_SECRET=change-me

# Optional
PORT=3000
SHOW_SQL=false

# Notehub ingress, OPTIONAL / LEGACY. Preferred: create an ingest-scoped API
# key in the dashboard (API Keys -> New key -> scope Ingest) and use that as
# the Bearer value in the Notehub route. If set, this static token is still
# accepted as a fallback and logs a deprecation warning.
# NOTEHUB_INGEST_TOKEN=

# Incident emails. Leave SMTP_HOST empty to disable sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_FROM=BioBot <alerts@example.com>
ALERT_EMAIL_TO=you@example.com
# Used for links in emails
DASHBOARD_URL=https://app.example.com
