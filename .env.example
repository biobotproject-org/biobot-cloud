# Copy to .env and fill in. The .env file is git-ignored.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=biobot
DB_USER=biobot
DB_PASSWORD=change-me

# Required. Generate with:  openssl rand -base64 32
JWT_SECRET=change-me

# Optional
PORT=3000
SHOW_SQL=false

# Notehub ingress. The Notehub route sends this value in the Authorization
# header as "Bearer <token>". Generate with:  openssl rand -hex 32
NOTEHUB_INGEST_TOKEN=change-me

# Incident emails. Leave SMTP_HOST empty to disable sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_FROM=BioBot <alerts@example.com>
ALERT_EMAIL_TO=you@example.com
# Used for links in emails
DASHBOARD_URL=https://app.example.com
